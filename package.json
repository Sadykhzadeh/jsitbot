{
  "name": "jsitbot",
  "version": "0.1.0",
  "description": "Telegram bot for running JavaScript in an isolated sandbox",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://got.az/azer/jsitbot.git"
  },
  "engines": {
    "bun": ">=1.3.10"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "bench": "bun run scripts/bench.ts",
    "soak": "bun run scripts/soak.ts",
    "typecheck": "tsc --noEmit",
    "compat": "bun run scripts/node-diff/run.ts"
  },
  "dependencies": {
    "grammy": "^1.46.0",
    "quickjs-emscripten": "^0.32.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "typescript": "^7.0.2"
  }
}
